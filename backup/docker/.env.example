# Copy to .env  (cp .env.example .env)  — .env is gitignored.

# Your Discord token (kept out of config.json so it isn't committed).
DCE_TOKEN=YOUR_DISCORD_TOKEN_HERE

# How often the backup runs (standard 5-field cron, evaluated in TZ below).
#   hourly  -> 0 * * * *
#   daily   -> 0 3 * * *      (03:00)
#   weekly  -> 0 3 * * 0      (Sun 03:00)
#   monthly -> 0 3 1 * *      (1st of month 03:00)
CRON_SCHEDULE=0 * * * *

# Run a backup immediately on container start (don't wait for the first tick).
RUN_ON_START=true

# Optional: minimum ms between Discord requests (throttle to avoid bans).
# Leave blank to use "requestDelayMs" from config.json. 1000-2000 is a safe range.
DCE_REQUEST_DELAY=

# Timezone for the schedule.
TZ=UTC

# Where backups are stored on the host.
BACKUP_DATA_DIR=./dce-data
